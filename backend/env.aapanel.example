# aaPanel (.env template) — backend/instaiq on your VPS
# Copy to /www/python/instaiq/backend/.env and fill the values.

# --- AI (required for real LLM answers) ---
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Instagram data (no tokens, no browser needed) ---
# Real data comes from the keyless direct Instagram HTTP layer: bootstrapped
# browser-like headers + cookies, then Instagram's own web_profile_info and
# GraphQL endpoints over plain HTTP. Nothing to install beyond requirements.
# Optional quality knobs:
# IG_FETCH_MODE=http            # http | off (default: http)
# IG_PERMALINK_POSTS=12         # posts+reels sampled for per-post engagement
# IG_LIKE_BACKFILL=45           # seconds budgeted for hidden-like backfill

# --- Data mode ---
# REAL DATA ONLY: no DATA_MODE / FALLBACK_TO_DEMO — simulated fallback was removed.

# --- Optional ---
# APIFY_TOKEN=
# IG_PROXY_URL=
# LLM_MODEL=gpt-oss-20b
# LLM_TOTAL_TIMEOUT=70
