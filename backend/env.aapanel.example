# aaPanel (.env template) — backend/instaiq on your VPS
# Copy to /www/python/instaiq/backend/.env and fill the values.

# --- AI (required for real LLM answers) ---
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Instagram data gateways (first entry = your relay) ---
IG_GATEWAY_URLS=https://ig-relay.raj15400881.workers.dev/?url={q},https://api.allorigins.win/raw?url={q},https://corsproxy.io/?url={q},https://api.codetabs.com/v1/proxy?quest={q},https://r.jina.ai/{q}
IG_GATEWAY_TOKEN=paste-your-relay-token-here  # see cloudflare-worker/.relay-token.local

# Gateway challenge retries (per gateway attempt count)
IG_GATEWAY_RETRIES=4

# --- Data mode ---
DATA_MODE=live
FALLBACK_TO_DEMO=false

# --- Optional ---
# APIFY_TOKEN=
# IG_PROXY_URL=
# LLM_MODEL=gpt-oss-20b
# LLM_TOTAL_TIMEOUT=70
