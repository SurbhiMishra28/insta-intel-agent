[TEMPLATE]
# === Data source ===
# REAL DATA ONLY: every fetch goes to a real provider (official Graph API,
# Apify actor, or the keyless Playwright Chromium headless browser) and is
# cached locally so repeats are instant. Failures are honest errors —
# simulated/demo data does not exist in this system.

# === Official Instagram Graph API (provider #0 — preferred) ============
# Real data straight from Meta's official API — no scraping, ToS-compliant.
# The query is business_discovery, so the TARGET account must be an
# Instagram Business/Creator (professional) account.
#   IG_ACCESS_TOKEN         — long-lived Facebook User access token with
#                             instagram_basic + instagram_manage_insights +
#                             pages_read_engagement
#   IG_BUSINESS_ACCOUNT_ID  — numeric ID of YOUR OWN Instagram professional
#                             account (the "app user" the query runs on)
#   IG_GRAPH_VERSION        — optional Graph API version (default v25.0)
# Setup steps: Meta developer app -> add Instagram product -> convert your
# IG account to Business/Creator linked to a Facebook Page -> generate a
# short-lived User token via Graph API Explorer with the 3 permissions ->
# exchange it for a long-lived token (GET /oauth/access_token?...
# grant_type=fb_exchange_token) -> put both values here.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# IG_GRAPH_VERSION=v25.0
# IG_GRAPH_TIMEOUT=20

# === AI (the ONLY API key this app needs) ===
# LLM (OpenAI-compatible). Default provider: OpenRouter — https://openrouter.ai
# (one key, many models; ':free' models have no cost). NVIDIA NIM still works:
# use an nvapi-... key and LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=

# --- Cross-provider failover (optional but recommended) ---------------------
# When every model on the primary provider fails (e.g. OpenRouter's free
# daily quota: 429 "free-models-per-day" on all candidates), the AI chains
# fall through to this second OpenAI-compatible provider instead of dropping
# to the deterministic rule-based engine. Any OpenAI-compatible endpoint works.
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# Optional tuning
# LLM_MAX_TOKENS=2000        # bounds every LLM chain
# LLM_TIMEOUT=45             # seconds per LLM call
# PROFILE_DISK_TTL=604800    # seconds a cached profile stays "fresh" (7 days)

# === Instagram live data (Apify) =====================================
# Optional: Apify actor token (https://console.apify.com → Settings →
# API & Integrations. NOTE: this token was committed at the owner's
# explicit request. The repo is PUBLIC — anyone can read and abuse this
# token, and GitHub secret scanning will flag it. Rotate it from the
# Apify console if usage spikes unexpectedly.
APIFY_TOKEN=your_apify_token_here

# --- Optional token failover (recommended) --------------------------
# Each free Apify account gets $5 of platform credit per billing cycle.
# When a token's credit is exhausted (or the token is revoked), the
# backend automatically benches it and retries the fetch on the next
# token in the pool, so a dead account never stalls live data. Add one
# token per extra free Apify account, in the order they should be used:
# APIFY_TOKEN_2=
# APIFY_TOKEN_3=
#   ... up to APIFY_TOKEN_9 — or paste a comma-separated list in one var:
# APIFY_TOKENS=token_a,token_b,token_c
# How long a failed token sits out before being retried (seconds):
# APIFY_TOKEN_COOLDOWN=1800

# Optional live-mode tuning
# APIFY_ACTOR_ID=apify/instagram-scraper
# APIFY_SEARCH_ACTOR_ID=apify/instagram-search-scraper
# APIFY_RUN_TIMEOUT=300       # seconds per actor run
# (removed) FALLBACK_TO_DEMO — simulated fallback was removed; failures are honest errors.

# --- Keyless direct fetch (provider #2) -----------------------------
# When the Apify pool is exhausted or unconfigured, the backend fetches
# real data with NO token: Instagram's own web_profile_info endpoint
# (browser-session bootstrap), an HTML parse fallback, a headless-Chrome
# render fallback, the classic GraphQL feed query (engagement), and
# per-post permalink renders. All best-effort layers; disable any time:
# DIRECT_FETCH=true           # master switch for the keyless provider
# DIRECT_FETCH_TIMEOUT=25     # seconds per direct HTTP call
# IG_CHROME_FETCH=true        # allow the headless-Chrome fallback layer
# IG_CHROME_PATH=C:/path/to/chrome.exe   # auto-detected when unset
# IG_GQL_QUERY_ID=17842794232208280      # classic feed GraphQL query id
# IG_PERMALINK_POSTS=6        # how many posts to enrich via permalinks
# --- Blocked-IP fallback (datacenter hosts: Render/Railway/Fly) -------------
# Instagram hard-blocks datacenter IPs. When direct fetching fails there, the
# backend routes Instagram's web_profile_info JSON through relay gateways.
# Recommended: your own free Cloudflare Worker relay (see cloudflare-worker/
# ig-relay.js in the repo root for the ready-made code + deploy steps).
# IG_GATEWAY_URLS=https://ig-relay.your-subdomain.workers.dev/?url={q}
# IG_GATEWAY_TOKEN=change-me-please   # must match RELAY_TOKEN in the Worker
#
# Optional residential/mobile proxy for the direct Instagram HTTP and Chrome
# layers. This does not authenticate a protected relay; IG_GATEWAY_TOKEN must
# still match the relay secret when IG_GATEWAY_URLS is configured.
# IG_PROXY_URL=http://user:pass@proxy-host:port
