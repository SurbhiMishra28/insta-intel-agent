# === Data mode ===
# live  = real public Instagram data via the Apify data provider (needs APIFY_TOKEN)
# demo  = deterministic simulated profiles (offline dev only)
DATA_MODE=live

# Data provider used when DATA_MODE=live:
#   apify    = paid Apify actors (default; needs APIFY_TOKEN)
#   graph    = free, official Meta Instagram Graph API (needs GRAPH_ACCESS_TOKEN
#              + GRAPH_IG_USER_ID; requires a Facebook developer account)
#   rapidapi = free tier of the "Instagram Cheapest" RapidAPI (30 calls/month,
#              needs RAPIDAPI_KEY — no Facebook account required)
DATA_PROVIDER=apify

# --- RapidAPI provider (free tier: 30 calls/month) ---
# Subscribe (free, no card) to "Instagram Cheapest" on rapidapi.com and
# paste your key here. Two calls per profile: info + media.
RAPIDAPI_KEY=
# RAPIDAPI_HOST=instagram-cheapest.p.rapidapi.com

# --- Meta Instagram Graph API (free provider) ---
# Long-lived Page/Instagram access token and the numeric ID of your own
# professional Instagram account (used to resolve business discovery).
# Leave blank when using Apify. Full setup: backend/GRAPH_API_SETUP.md
GRAPH_ACCESS_TOKEN=
GRAPH_IG_USER_ID=
# GRAPH_API_VERSION=v21.0

# Apify token (https://apify.com → Console → Settings → API & Integrations → API token)
# Required when DATA_MODE=live and DATA_PROVIDER=apify
APIFY_TOKEN=
# Optional SECOND Apify account token: when the primary account's monthly
# credit is exhausted, fetches automatically rotate to this account.
# APIFY_TOKEN_2=

# Optional: use a different Instagram actor (defaults to apify/instagram-scraper)
# APIFY_ACTOR_ID=apify/instagram-scraper

# Optional tuning
# APIFY_RUN_TIMEOUT=300      # max seconds to wait for an actor run
# PROFILE_CACHE_TTL=1800     # seconds to reuse a fetched profile before refetching
# FALLBACK_TO_DEMO=false     # set true to serve simulated data if the live fetch fails

# === AI summaries (optional) ===
# Set these to enable LLM-written reports; leave blank for the rule-based engine
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=minimax/minimax-m3
